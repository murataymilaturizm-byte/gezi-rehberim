<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#052e16"/>
      <stop offset="100%" style="stop-color:#0f172a"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="630" fill="url(#bg)"/>
  <circle cx="900" cy="200" r="350" fill="#25D366" opacity="0.06"/>

  <!-- WhatsApp icon -->
  <circle cx="140" cy="280" r="55" fill="#25D366" opacity="0.2"/>
  <text x="140" y="300" font-family="system-ui,sans-serif" font-size="48" text-anchor="middle" fill="#25D366">💬</text>

  <rect x="0" y="0" width="6" height="630" fill="#25D366" opacity="0.8"/>

  <text x="220" y="220" font-family="system-ui,sans-serif" font-size="20" fill="#4ade80" font-weight="500">WhatsApp Chatbot</text>
  <text x="220" y="290" font-family="system-ui,-apple-system,sans-serif" font-size="54" font-weight="700" fill="white">WhatsApp ile</text>
  <text x="220" y="360" font-family="system-ui,-apple-system,sans-serif" font-size="54" font-weight="700" fill="white">Müşteri Yönetimi</text>
  <text x="220" y="440" font-family="system-ui,sans-serif" font-size="24" fill="#64748b">Seyahat Acenteleri için Rehber</text>

  <text x="220" y="560" font-family="system-ui,sans-serif" font-size="20" fill="#4ade80" opacity="0.7">turzzai.com</text>
</svg>
