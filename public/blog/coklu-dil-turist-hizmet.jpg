<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#042f2e"/>
      <stop offset="100%" style="stop-color:#0f172a"/>
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#14b8a6"/>
      <stop offset="100%" style="stop-color:#06b6d4"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="630" fill="url(#bg)"/>
  <circle cx="1000" cy="150" r="300" fill="#0d9488" opacity="0.07"/>

  <!-- Globe icon area -->
  <circle cx="140" cy="280" r="55" fill="#0d9488" opacity="0.2"/>
  <text x="140" y="300" font-family="system-ui,sans-serif" font-size="42" text-anchor="middle" fill="#2dd4bf">🌍</text>

  <rect x="0" y="0" width="6" height="630" fill="url(#accent)"/>

  <!-- Language flags -->
  <text x="800" y="180" font-family="system-ui,sans-serif" font-size="38" opacity="0.4">🇹🇷 🇬🇧 🇩🇪</text>
  <text x="820" y="260" font-family="system-ui,sans-serif" font-size="38" opacity="0.3">🇷🇺 🇸🇦 🇫🇷 🇪🇸</text>

  <text x="220" y="220" font-family="system-ui,sans-serif" font-size="20" fill="#2dd4bf" font-weight="500">Çok Dilli Hizmet</text>
  <text x="220" y="290" font-family="system-ui,-apple-system,sans-serif" font-size="54" font-weight="700" fill="white">7 Dilde Yabancı</text>
  <text x="220" y="360" font-family="system-ui,-apple-system,sans-serif" font-size="54" font-weight="700" fill="white">Turist Hizmeti</text>
  <text x="220" y="440" font-family="system-ui,sans-serif" font-size="24" fill="#64748b">Incoming Acenteler için Kılavuz</text>
  <text x="220" y="560" font-family="system-ui,sans-serif" font-size="20" fill="#2dd4bf" opacity="0.7">turzzai.com</text>
</svg>
