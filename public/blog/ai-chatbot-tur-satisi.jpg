<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e1b4b"/>
      <stop offset="100%" style="stop-color:#0f172a"/>
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#8b5cf6"/>
      <stop offset="100%" style="stop-color:#06b6d4"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="630" fill="url(#bg)"/>
  <circle cx="950" cy="100" r="320" fill="#7c3aed" opacity="0.07"/>
  <circle cx="200" cy="500" r="250" fill="#06b6d4" opacity="0.06"/>

  <!-- AI icon area -->
  <circle cx="140" cy="280" r="55" fill="#7c3aed" opacity="0.2"/>
  <text x="140" y="300" font-family="system-ui,sans-serif" font-size="42" text-anchor="middle" fill="#a78bfa">🤖</text>

  <rect x="0" y="0" width="6" height="630" fill="url(#accent)"/>

  <text x="220" y="220" font-family="system-ui,sans-serif" font-size="20" fill="#a78bfa" font-weight="500">Yapay Zeka</text>
  <text x="220" y="290" font-family="system-ui,-apple-system,sans-serif" font-size="54" font-weight="700" fill="white">AI Chatbot ile</text>
  <text x="220" y="360" font-family="system-ui,-apple-system,sans-serif" font-size="54" font-weight="700" fill="white">Tur Satışı</text>
  <text x="220" y="440" font-family="system-ui,sans-serif" font-size="24" fill="#64748b">Otomatik Rezervasyon Rehberi</text>
  <text x="220" y="560" font-family="system-ui,sans-serif" font-size="20" fill="#a78bfa" opacity="0.7">turzzai.com</text>
</svg>
